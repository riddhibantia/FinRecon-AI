# Copy to .env and fill locally. Never commit .env with real secrets.
# WARNING: any `changeme` default below MUST be changed in prod.

POSTGRES_DB=finrecon
POSTGRES_USER=finrecon
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finrecon:changeme@localhost:5432/finrecon

# Monolith port
FINRECON_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=3000

# Dashboard origins (server-side only; the browser calls /api/* only)
FINRECON_API_URL=http://localhost:8080
FINRECON_AI_API_URL=http://localhost:8000

# AI service model dir (mounted read-only into the container as /models).
FINRECON_MODEL_DIR=./ai-service/artifacts/p6/models