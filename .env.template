# Copy to .env and fill locally. Never commit .env with real secrets.
# P0 only needs Postgres. All other values are placeholders for later phases.

POSTGRES_DB=finrecon
POSTGRES_USER=finrecon
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finrecon:changeme@localhost:5432/finrecon

# Service ports (P0 defaults)
GATEWAY_PORT=8080
INGESTION_PORT=8081
RECONCILIATION_PORT=8082
EXCEPTION_PORT=8083
REPORTING_PORT=8084
AI_SERVICE_PORT=8000
FRONTEND_PORT=3000

# P5 messaging (only needed where Kafka/Redis run)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
REDIS_HOST=localhost
REDIS_PORT=6379
