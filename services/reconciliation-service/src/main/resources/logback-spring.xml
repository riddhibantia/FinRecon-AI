<!-- P12 structured logging: timestamp, thread, level, requestId from the
     P11 CorrelationFilter MDC, then the message. No payloads or PII are
     logged by construction: services log identifiers and counts only. -->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{ISO8601} [%thread] %-5level [%X{requestId}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="com.finrecon" level="INFO"/>
  <logger name="org.hibernate" level="WARN"/>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
